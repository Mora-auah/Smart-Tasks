# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Model names: choose per current OpenAI docs
MODEL_DAILY_SUMMARY=
MODEL_CHAT=
# Server listens on the local machine only
HOST=127.0.0.1
PORT=8000
# Defines the day boundary (local midnight)
TIMEZONE=Asia/Jerusalem
DATABASE_URL=sqlite:///./data/smart_tasks.db
